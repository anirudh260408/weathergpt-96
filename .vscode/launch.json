{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dev Server (Full Stack)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "restart": true,
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Launch Chrome on http://localhost:3000",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Server + Chrome Debugger",
      "configurations": ["Run Dev Server (Full Stack)", "Launch Chrome on http://localhost:3000"]
    }
  ]
}
